rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'superadmin';
    }

    // Fiches de rôle du personnel : tout compte connecté peut lire
    // (pour connaître son propre rôle), seul un super admin peut écrire.
    match /users/{email} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Données de la salle : accès réservé aux comptes connectés
    // (gérants et super admin). Mono-salle : pas de cloisonnement
    // par tenant nécessaire.
    match /members/{id} { allow read, write: if request.auth != null; }
    match /payments/{id} { allow read, write: if request.auth != null; }
    match /tickets/{id} { allow read, write: if request.auth != null; }
    match /checkins/{id} { allow read, write: if request.auth != null; }
  }
}
