rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accès réservé aux comptes connectés (admin, réception, coach)
    // créés depuis Firebase Auth. Mono-salle : pas de cloisonnement
    // par tenant nécessaire, tout utilisateur connecté a accès aux
    // données de CETTE salle.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
